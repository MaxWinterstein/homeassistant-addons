{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "mergeConfidence:all-badges",
    "config:recommended",
    "config:js-app",
    ":disableDigestUpdates",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeTypes",
    "customManagers:dockerfileVersions",
  ],
  rebaseWhen: "conflicted",
  dependencyDashboard: true,
  dependencyDashboardAutoclose: true,
  labels: ["dependencies", "no-stale"],
  commitMessageTopic: "{{depName}}",
  customManagers: [
    {
      // Every base image in build.json. CI, publishing and the Supervisor
      // build from these, not from the Dockerfile's ARG BUILD_FROM default.
      customType: "regex",
      managerFilePatterns: ["/(^|/)build\\.json$/"],
      matchStrings: [
        '"(aarch64|amd64|armhf|armv7|i386)":\\s*"(?<depName>[^"\\s]+):(?<currentValue>[^"\\s]+)"',
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      // Dockerfiles are already covered by Renovate's dockerfile manager (ARG
      // BUILD_FROM); matching them here too would produce duplicate updates.
      managerFilePatterns: ["/(^|/)build\\.yaml$/"],
      matchStringsStrategy: "any",
      matchStrings: [
        "ARG BUILD_FROM=(?<depName>.*?):(?<currentValue>.*?)\\s+",
        "(aarch64|amd64|armhf|armv7|i386):\\s[\"']?(?<depName>.*?):(?<currentValue>.*?)[\"']?\\s",
      ],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      matchFileNames: ["adsb-multi-portal-feeder/**"],
      groupName: "adsb-multi-portal-feeder dependencies",
    },
    {
      matchFileNames: ["fr24-sharing-key-generator/**"],
      groupName: "fr24-sharing-key-generator dependencies",
    },
    {
      matchFileNames: ["planefence/**"],
      groupName: "planefence dependencies",
    },
    {
      // Tags are latest-build-<n>; compare <n> numerically.
      matchDepNames: ["ghcr.io/sdr-enthusiasts/docker-planefence"],
      versioning: "regex:^latest-build-(?<major>\\d+)$",
    },
    {
      // One PR for the aarch64 and amd64 base images (build.json) and the
      // Dockerfile default, so the architectures can't drift apart.
      matchFileNames: ["toogoodtogo-ha-mqtt-bridge/**"],
      matchDepNames: ["/-base-python$/"],
      groupName: "toogoodtogo-ha-mqtt-bridge base image",
    },
    {
      matchFileNames: ["*.*", ".gitlab/**"],
      commitMessagePrefix: "",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      matchDepNames: ["uv"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      // Everything in the CI workflows: the actions themselves and tool versions
      // pinned inside them (e.g. uv for setup-uv). Monthly and automerged; a
      // broken update fails the PR's own workflow run and so never merges.
      matchFileNames: [".github/workflows/**"],
      groupName: "github workflows",
      // One PR, majors included, rather than a separate major PR that may even
      // contradict the minor one (e.g. "pin to v6.1.0" next to "update to v7").
      separateMajorMinor: false,
      schedule: ["* 0-3 1 * *"],
      automerge: true,
    },
    {
      // Dev-container tooling (task, yq, uv, docker, buildx, gh), pinned in the
      // VibePod overlay. Not part of any add-on, so one PR a month, merged
      // automatically once the checks pass.
      matchFileNames: [".vibepod/**"],
      groupName: "vibepod overlay tooling",
      schedule: ["* 0-3 1 * *"],
      automerge: true,
    },
  ],
  ignorePaths: [
    "portainer/*",
    "awtrix/*",
    "octoprint-proxy/*",
    "ioBroker/*",
    "eufy-ha-mqtt-bridge/*",
  ],
  commitMessagePrefix: "[{{packageFileDir}}]",
  gitIgnoredAuthors: ["renovate[bot]", "github-actions"],
  prHeader: '{"prProperties": {"branchName": "{{branchName}}", "depName": "{{depName}}", "newVersion": "{{newValue}}"}}\n',
}
